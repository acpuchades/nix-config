#!/usr/bin/env python3
"""check-calendar — list upcoming events from an iCalendar (.ics) calendar.

Takes a calendar SOURCE that is either:
  * a URL — fetched through the `request-trusted-url` wrapper, so the fetch is
    subject to the SAME trusted-host allowlist, GET-only method and no-redirect
    policy as any other sanctioned web read (no new outbound surface); or
  * a local .ics file, or "-"/omitted for stdin — parsed offline.

It expands recurring events (RRULE) to their real occurrences and prints the
ones inside an upcoming window. The URL path means the common case is ONE
command with no pipe (the exec gate prefers that):

    check-calendar https://cloud.acpuchades.com/remote.php/dav/…/cal.ics --days 14
    check-calendar meeting.ics --days 7 --json      # local file
    request-trusted-url <ics-url> | check-calendar   # still works via stdin

Works with any provider that exposes an .ics export/secret-link (Google
Calendar, Apple iCloud, Microsoft/Outlook, Nextcloud, …); nothing here is
provider-specific. A URL host must be a trusted site (request-trusted-url
enforces this); otherwise the fetch is refused.

Usage:
    check-calendar [SOURCE] [--days N] [--max N] [--json]
      SOURCE      an https:// URL, a .ics file, or "-"/omitted for stdin
      --days N     look-ahead window in days     (default 14)
      --max N      maximum events to print        (default 50)
      --json       emit JSON instead of a summary
"""
import sys
import json
import shutil
import argparse
import subprocess
from datetime import datetime, timedelta, timezone


def fetch_via_trusted_url(url):
    """Fetch a URL through the request-trusted-url wrapper (which enforces the
    trusted-host allowlist, GET-only method and no redirects). Reusing that
    binary keeps a single, vetted outbound path — check-calendar adds no fetch
    logic or trust list of its own."""
    exe = shutil.which("request-trusted-url")
    if not exe:
        print("check-calendar: request-trusted-url is not available, so a URL "
              "cannot be fetched here — pass a local .ics file or pipe the data "
              "in on stdin instead.", file=sys.stderr)
        raise SystemExit(3)
    try:
        proc = subprocess.run([exe, url], capture_output=True, timeout=90)
    except subprocess.TimeoutExpired:
        print("check-calendar: timed out fetching the calendar URL", file=sys.stderr)
        raise SystemExit(1)
    if proc.returncode != 0:
        # Surface request-trusted-url's own message (e.g. "host not a trusted site").
        if proc.stderr:
            sys.stderr.buffer.write(proc.stderr)
        print(f"check-calendar: could not fetch the calendar "
              f"(request-trusted-url exited {proc.returncode})", file=sys.stderr)
        raise SystemExit(proc.returncode)
    return proc.stdout


def main():
    ap = argparse.ArgumentParser(
        prog="check-calendar",
        description="List upcoming events from an .ics calendar (URL or local).",
    )
    ap.add_argument("source", nargs="?", default="-",
                    help='an https:// URL, a .ics file, or "-"/omitted for stdin')
    ap.add_argument("--days", type=int, default=14,
                    help="look-ahead window in days (default 14)")
    ap.add_argument("--max", dest="max", type=int, default=50,
                    help="maximum events to print (default 50)")
    ap.add_argument("--json", action="store_true",
                    help="emit JSON instead of a text summary")
    args = ap.parse_args()

    if args.days < 0:
        print("check-calendar: --days must be >= 0", file=sys.stderr)
        return 2

    try:
        import icalendar
        import recurring_ical_events
    except ImportError as exc:  # pragma: no cover - guarded by the nix wrapper
        print(f"check-calendar: missing dependency: {exc}", file=sys.stderr)
        return 4

    src = args.source
    if src.startswith("http://") or src.startswith("https://"):
        raw = fetch_via_trusted_url(src)
    elif src in ("-", ""):
        raw = sys.stdin.buffer.read()
    else:
        raw = open(src, "rb").read()
    if not raw.strip():
        print("check-calendar: empty input (no calendar data)", file=sys.stderr)
        return 1

    try:
        cal = icalendar.Calendar.from_ical(raw)
    except Exception as exc:
        print(f"check-calendar: could not parse calendar: {exc}", file=sys.stderr)
        return 1

    local = datetime.now().astimezone().tzinfo
    start = datetime.now(timezone.utc)
    end = start + timedelta(days=args.days)

    try:
        occurrences = recurring_ical_events.of(cal).between(start, end)
    except Exception as exc:
        print(f"check-calendar: could not expand events: {exc}", file=sys.stderr)
        return 1

    def sortable(value):
        # Normalize date (all-day) and naive/aware datetimes to an aware datetime
        # so the mixed set sorts. A floating (naive) time is read as local.
        if isinstance(value, datetime):
            return value if value.tzinfo else value.replace(tzinfo=local)
        return datetime(value.year, value.month, value.day, tzinfo=local)

    def text(ev, key):
        value = ev.get(key)
        return str(value) if value is not None else None

    rows = []
    for ev in occurrences:
        dtstart = ev.get("DTSTART")
        if dtstart is None:
            continue
        st = dtstart.dt
        dtend = ev.get("DTEND")
        en = dtend.dt if dtend is not None else None
        rows.append({
            "summary": text(ev, "SUMMARY") or "(no title)",
            "start": st,
            "end": en,
            "all_day": not isinstance(st, datetime),
            "location": text(ev, "LOCATION"),
            "_key": sortable(st),
        })

    rows.sort(key=lambda r: r["_key"])
    rows = rows[: args.max]

    if args.json:
        def iso(value):
            return value.isoformat() if value is not None else None
        print(json.dumps({
            "window_days": args.days,
            "count": len(rows),
            "events": [{
                "summary": r["summary"],
                "start": iso(r["start"]),
                "end": iso(r["end"]),
                "all_day": r["all_day"],
                "location": r["location"],
            } for r in rows],
        }, ensure_ascii=False, indent=2))
        return 0

    if not rows:
        print(f"No events in the next {args.days} day(s).")
        return 0

    def fmt(r):
        st = r["start"]
        if r["all_day"]:
            head = st.strftime("%a %d %b") + " · all day"
        else:
            local_start = sortable(st).astimezone(local)
            head = local_start.strftime("%a %d %b %H:%M")
            en = r["end"]
            if isinstance(en, datetime):
                head += "–" + sortable(en).astimezone(local).strftime("%H:%M")
        line = f"{head}  {r['summary']}"
        if r["location"]:
            line += f"  @ {r['location']}"
        return line

    print(f"Next {args.days} day(s) — {len(rows)} event(s):")
    for r in rows:
        print("  " + fmt(r))
    return 0


if __name__ == "__main__":
    sys.exit(main())
