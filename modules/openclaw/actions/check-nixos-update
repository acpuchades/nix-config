#!/usr/bin/env bash
#
# check-nixos-update — latest commit on a NixOS channel branch.
# Destination-fixed: always api.github.com/repos/NixOS/nixpkgs (pinned by the
# nix wrapper). No user-supplied arguments change the endpoint or repository.
#
# Usage: check-nixos-update [--branch BRANCH]
#   --branch BRANCH   nixpkgs branch to check (default: value of NIXOS_BRANCH)
#
# Environment (pinned by the wrapper):
#   NIXOS_BRANCH      default branch to check (e.g. nixos-26.05)
#   NIXOS_API_BASE    override the API base URL (optional)
#
set -euo pipefail

: "${NIXOS_BRANCH:?NIXOS_BRANCH not set}"
API_BASE="${NIXOS_API_BASE:-https://api.github.com}"

BRANCH="$NIXOS_BRANCH"
while [ $# -gt 0 ]; do
  case "$1" in
    --branch|-b) BRANCH="${2?missing value for --branch}"; shift 2 ;;
    -h|--help)   sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "check-nixos-update: unknown argument: $1" >&2; exit 2 ;;
  esac
done

RESP="$(curl -sS --max-time 30 \
  -H "Accept: application/vnd.github+json" \
  -H "X-GitHub-Api-Version: 2022-11-28" \
  "${API_BASE}/repos/NixOS/nixpkgs/commits/${BRANCH}?per_page=1")"

SHA=$(printf '%s' "$RESP" | jq -r '.sha // empty')
[ -n "$SHA" ] || { echo "check-nixos-update: unexpected API response" >&2; exit 1; }

DATE=$(printf '%s' "$RESP" | jq -r '.commit.committer.date')
MSG=$(printf '%s' "$RESP" | jq -r '.commit.message | split("\n") | .[0]')

printf '%s latest:\n  sha:  %s\n  date: %s\n  msg:  %s\n' \
  "$BRANCH" "${SHA:0:12}" "$DATE" "$MSG"
