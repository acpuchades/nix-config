#!/bin/sh
# Generic send-email action for an openclaw agent.
#
# Recipients are positional ARGUMENTS; the message (headers + body) is read from
# stdin. Deliberately NOT `sendmail -t`: the To/Cc/Bcc headers do not route, so a
# poisoned message cannot smuggle a hidden recipient — the delivered set is
# exactly the arguments (which is also what the openclaw exec allowlist matches).
#
# This script is identity-agnostic: nothing about the agent or its address is
# baked in. The sender, if any, is supplied by the nix module as $MAIL_FROM, and
# the sendmail binary as $SENDMAIL (both pinned by the immutable wrapper the
# module builds around this file).
#
# $ENCRYPT_ONLY_ADDRESSES (space-separated, lowercase, also pinned) is the set of
# recipients the module has declared confidential. This script refuses them
# outright: their mail goes through send-encrypted-mail or not at all. That is
# what makes confidentiality structural rather than a mode the agent elects —
# there is no plaintext fallback to be talked into.
set -eu

if [ "$#" -lt 1 ]; then
  echo "usage: $(basename "$0") RECIPIENT [RECIPIENT...]  (message on stdin)" >&2
  exit 2
fi

for r in "$@"; do
  rl=$(printf '%s' "$r" | tr 'A-Z' 'a-z')
  for a in ${ENCRYPT_ONLY_ADDRESSES:-}; do
    if [ "$rl" = "$a" ]; then
      echo "refused: '$r' only accepts encrypted mail — use send-encrypted-mail" >&2
      exit 4
    fi
  done
done

sendmail=${SENDMAIL:-sendmail}

# Build the invocation in front of the recipients, which are already in "$@":
# `--` first so an address can never be read as a flag, then the identity flags.
# -f is the envelope sender; -F is the display name Postfix puts in the From:
# header it generates for a message that has none (this one, by design — the
# agent composes To:/Subject:/body, never From:). Both are pinned by the module.
set -- -- "$@"
if [ -n "${MAIL_FROM_NAME:-}" ]; then
  set -- -F "$MAIL_FROM_NAME" "$@"
fi
if [ -n "${MAIL_FROM:-}" ]; then
  set -- -f "$MAIL_FROM" "$@"
fi

exec "$sendmail" -i "$@"
